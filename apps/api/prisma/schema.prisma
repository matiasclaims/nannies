// ============================================================
//  Nannies Child Care — Esquema de datos (Prisma + PostgreSQL)
//  Alcance de este archivo: NÚCLEO de identidad + M1 (Calendario/
//  Disponibilidad). Las tablas de M3/M4/M6 se agregan al construir
//  cada módulo (módulo por módulo — README §4).
//
//  Cifras de negocio NO viven aquí: el tabulador de pago, cobros e
//  incidencias son datos verificados contra fuente y se cablean en
//  la lógica de M3/M4, no en el esquema.
//
//  Convención de seguridad: los campos PII de menores viven en `Nino`
//  y el filtrado por rol se impone en el backend (serializadores),
//  NO en el frontend (SEGURIDAD §2 y §3).
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
//  Enums
// ------------------------------------------------------------

enum Rol {
  DIRECTORA // Paula — acceso total, ve margen y confirma consecuencias
  SUBDIRECTORA // Jackeline — opera todo menos el margen
  NANNIE // solo lo suyo; familias en vista operativa (sin PII de menores)
}

enum Plaza {
  TOLUCA
  QUERETARO
  // precio único multi-plaza por ahora; la dimensión existe por si cambia
}

// Rango permanente por servicios acumulados de por vida (nunca se pierde)
// 50→ROOKIE(+3%) · 80→JUNIOR(+7%) · 130→SENIOR(+10%)  (DATOS-FUENTE §4)
enum RangoPermanente {
  BASE
  ROOKIE
  JUNIOR
  SENIOR
}

// Columnas del tabulador de PAGO (PE 2026, 5 niveles).
// El nivel-tarifa MENSUAL se fija en el cierre de mes (M3) según el
// umbral de 25 hrs; NO se recalcula servicio a servicio. La lógica de
// derivación vive en M3 (pendiente de confirmar el caso "Salario 25hrs"
// para rango BASE — ver nota a Matías).
enum NivelTarifa {
  BASE // Salario Base
  TARIFA_25HRS // Salario 25hrs mensuales
  ROOKIE
  JUNIOR
  SENIOR
}

enum EstadoNannie {
  ACTIVA
  PAUSA
  PRUEBA // p.ej. calificación < 7.5 → 1 mes de prueba (incidencia #14)
  BAJA // ya no colabora (incidencias #7/#11); conserva historial
}

enum EstadoFamilia {
  ACTIVA
  INACTIVA
  SUSPENDIDA // p.ej. recontratación externa (Reglamento §8)
}

// Clase operativa del servicio (Reglamento PF §"Servicio / No. de niños").
// NOTA (interpretación a confirmar): la fuente agrupa "Daycare/Nightcare"
// en una fila; aquí se separan porque la distinción día/noche es real y
// ya la captura el horario — mismo menú de precio.
// "Paquetes de horas" NO es una clase aquí: es un FORMATO (ver Formato);
// cada sesión de un paquete tiene su propia clase.
enum TipoServicio {
  DAYCARE // 1-3 niños
  NIGHTCARE // 1-3 niños
  ACOMPANAMIENTO_EVENTO // 1-3 niños
  NANNIE_EXPRESS // 1-3 niños
  NANNIE_FORANEA // 1-3 niños
  NANNIE_FIESTA_PLAYDATE // 4-8 niños
  LUDOTECA_MOVIL // 4-8 niños por estación
}

enum Formato {
  INDIVIDUAL // cobro manual al realizarse
  PAQUETE // modelo "saldo": cobro automático al asignar, se consume por servicio
}

enum EstadoServicio {
  OFERTADO
  ACEPTADO
  RECHAZADO
  COMPLETADO
  CANCELADO
}

enum EstadoDisponibilidad {
  DISPONIBLE
  BLOQUEADO
  TEMPORAL // bloqueo temporal con fecha de reintegro
}

enum RespuestaOferta {
  ACEPTO
  RECHAZO
}

enum EstadoPaquete {
  ACTIVO // con saldo de horas disponible
  CONSUMIDO // saldo agotado
  CANCELADO
}

// ------------------------------------------------------------
//  Identidad y acceso (transversal — roles desde el día 1)
// ------------------------------------------------------------

model Usuario {
  id           String   @id @default(cuid())
  nombre       String
  email        String   @unique
  passwordHash String // argon2/bcrypt — NUNCA texto plano (SEGURIDAD §4)
  rol          Rol
  activo       Boolean  @default(true)
  foto         String? // avatar (data URL redimensionada ~400px); solo coord/directora

  // Contraseña temporal al alta (M4): fuerza el cambio en el primer ingreso.
  debeCambiarPassword Boolean @default(false)
  // Si rol = NANNIE, enlaza con su ficha. La pertenencia (token.nannieId
  // == recurso) se verifica en cada consulta de nannie (SEGURIDAD §4).
  nannieId     String?  @unique
  nannie       Nannie?  @relation(fields: [nannieId], references: [id])
  creadoEn     DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@map("usuarios")
}

// ------------------------------------------------------------
//  Nannies (identidad + nivel; expediente/documentos completos → M4)
// ------------------------------------------------------------

model Nannie {
  id                  String          @id @default(cuid())
  nombre              String
  telefono            String? // contacto (M4 expediente)
  foto                String? // avatar (data URL redimensionada ~400px)
  especialidad        String? // perfil: para qué es especialista / experiencia (M4)
  plaza               Plaza
  zonas               String[] // zonas que cubre (perfil geográfico)
  color               String? // color para identificarla rápido (M4; se asigna al alta)
  rangoPermanente     RangoPermanente @default(BASE)
  serviciosAcumulados Int             @default(0) // contador de por vida (M4)
  nivelTarifaMesActual NivelTarifa    @default(BASE) // lo fija M3 en el cierre de mes
  estado              EstadoNannie    @default(PRUEBA)
  // Cumplimiento (base de las incidencias #1 y #3): sin docs no se asignan
  // servicios; sin capacitación se retiene el pago. Los booleanos se DERIVAN de
  // tener todas las claves del catálogo (ver catalogos.ts); los arreglos guardan
  // qué documentos/cursos ya cumplió cada nannie.
  documentacionCompleta Boolean       @default(false)
  capacitacionCompleta  Boolean       @default(false)
  documentosEntregados  String[]      @default([])
  cursosCompletados     String[]      @default([])
  creadoEn            DateTime        @default(now())
  actualizadoEn       DateTime        @updatedAt

  usuario         Usuario?
  disponibilidad  Disponibilidad[]
  servicios       Servicio[]
  ofertas         OfertaRespuesta[]
  cierres         CierreMes[]
  bonos           Bono[]
  nominaPagos     NominaPago[]
  incidencias     Incidencia[]
  notas           NotaNannie[]
  evaluaciones    EvaluacionNannie[]

  @@map("nannies")
}

// Evaluación de desempeño de la nannie (M4, punto G). La registra coordinación
// (Paula/Jackie) por SEMANA (dom-sáb). Cinco pilares 1-10 ponderados a 100%
// (catálogo de pilares y pesos en evaluaciones.catalogo.ts). La calificación es
// la suma ponderada. `semana` = domingo de inicio.
model EvaluacionNannie {
  id                   String   @id @default(cuid())
  nannieId             String
  nannie               Nannie   @relation(fields: [nannieId], references: [id])
  semana               DateTime @db.Date
  atencionInfantil     Int
  cumplimientoServicio Int
  comunicacion         Int
  profesionalismo      Int
  puntualidad          Int
  calificacion         Decimal  @db.Decimal(4, 2) // ponderada 1-10 (ej. 8.35)
  evaluadaPor          String
  nota                 String?
  creadoEn             DateTime @default(now())
  actualizadoEn        DateTime @updatedAt

  @@unique([nannieId, semana])
  @@index([nannieId])
  @@map("evaluaciones_nannie")
}

// Incidencia registrada contra una nannie (M4). Detección MANUAL (coordinación),
// cálculo de consecuencia AUTOMÁTICO, aplicación al pago MANUAL (Directora).
// El catálogo de reglas y sus consecuencias viven en código (incidencias.catalogo.ts).
// `estado`: ACUMULANDO (cuenta hacia el umbral), PENDIENTE (penalización lista),
// APLICADA, DESCARTADA.
enum EstadoIncidencia {
  ACUMULANDO
  APLICADA
  DESCARTADA
  CONDONADA
}

model Incidencia {
  id            String           @id @default(cuid())
  nannieId      String
  nannie        Nannie           @relation(fields: [nannieId], references: [id])
  regla         Int // 2..14 (ver catálogo)
  fecha         DateTime         @default(now())
  registradaPor String // nombre de quien la registró
  nota          String?
  estado        EstadoIncidencia @default(ACUMULANDO)
  aplicadaEn    DateTime?

  @@index([nannieId, regla])
  @@map("incidencias")
}

// Bitácora de coordinación por nannie (M4): notas libres que SOLO ven Paula y
// Jackie (no la nannie). No son incidencias ni penalizan; sirven para la
// asignación (química con familias, cancelaciones justificadas, etc.).
model NotaNannie {
  id          String   @id @default(cuid())
  nannieId    String
  nannie      Nannie   @relation(fields: [nannieId], references: [id])
  texto       String
  autorNombre String // quién la escribió (Paula/Jackie)
  creadoEn    DateTime @default(now())

  @@index([nannieId])
  @@map("notas_nannie")
}

// Bono manual a una nannie (M3): monto + motivo, decidido por la Directora. No
// tiene reglas automáticas; reduce el margen. Se registra a quién y por qué.
model Bono {
  id       String   @id @default(cuid())
  nannieId String
  nannie   Nannie   @relation(fields: [nannieId], references: [id])
  monto    Decimal  @db.Decimal(10, 2)
  motivo   String
  fecha    DateTime @default(now())

  @@index([nannieId])
  @@map("bonos")
}

// Marca de nómina pagada (M3): registra que a una nannie ya se le pagó su
// nómina de una semana (dom-sáb). La EXISTENCIA del registro = pagado; se
// quita el registro para desmarcar. `semana` es el domingo de inicio.
model NominaPago {
  id       String   @id @default(cuid())
  nannieId String
  nannie   Nannie   @relation(fields: [nannieId], references: [id])
  semana   DateTime @db.Date
  pagadoEn DateTime @default(now())

  @@unique([nannieId, semana])
  @@map("nomina_pagos")
}

// ------------------------------------------------------------
//  Familias y niños (M5 completo después; aquí el núcleo para M1)
// ------------------------------------------------------------

model Familia {
  id            String        @id @default(cuid())
  nombreContacto String
  telefono      String?
  email         String?
  plaza         Plaza
  zona          String?
  estado        EstadoFamilia @default(ACTIVA)
  fechaAlta     DateTime      @default(now())
  actualizadoEn DateTime      @updatedAt

  ninos     Nino[]
  servicios Servicio[]
  paquetes  Paquete[]
  notas     NotaFamilia[]

  @@map("familias")
}

// PII de MENORES — máxima protección. El backend nunca envía estos campos
// a un rol distinto de DIRECTORA; la nannie recibe solo la vista operativa
// (rutinas/necesidades/salud) filtrada por serializador (SEGURIDAD §2/§3).
model Nino {
  id          String   @id @default(cuid())
  familiaId   String
  familia     Familia  @relation(fields: [familiaId], references: [id])
  // --- Identificable: coordinación (Directora + Subdirectora); la nannie NO ---
  nombre      String
  apellidos   String?
  edad        Int?
  genero      String?
  // --- Operativo: visible a la nannie asignada ---
  rutinas     String?
  necesidades String?
  salud       String? // alergias/condiciones — sensible; vista operativa acotada
  creadoEn    DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([familiaId])
  @@map("ninos")
}

// Bitácora de la familia (M5 §5.3): conocimiento acumulado / recomendaciones de
// nannies que la atendieron. Se nutre aparte del reporte de servicio (M6).
model NotaFamilia {
  id          String   @id @default(cuid())
  familiaId   String
  familia     Familia  @relation(fields: [familiaId], references: [id])
  texto       String
  autorNombre String? // quién dejó la nota (nannie/coordinación)
  creadoEn    DateTime @default(now())

  @@index([familiaId])
  @@map("notas_familia")
}

// ------------------------------------------------------------
//  M1 · Disponibilidad y Calendario
// ------------------------------------------------------------

model Disponibilidad {
  id            String               @id @default(cuid())
  nannieId      String
  nannie        Nannie               @relation(fields: [nannieId], references: [id])
  fecha         DateTime             @db.Date
  horaInicio    String // "HH:mm"
  horaFin       String
  estado        EstadoDisponibilidad @default(DISPONIBLE)
  fechaReintegro DateTime?           @db.Date // solo si estado = TEMPORAL
  creadoEn      DateTime             @default(now())

  @@index([nannieId, fecha])
  @@map("disponibilidad")
}

// TABLA MAESTRA de asignaciones — vive en M1. M2 solo la escribe tras la
// decisión de Paula; M2 no tiene tabla propia (ARQUITECTURA §4/§5).
model Servicio {
  id           String         @id @default(cuid())
  familiaId    String
  familia      Familia        @relation(fields: [familiaId], references: [id])
  nannieId     String? // null mientras está por asignar
  nannie       Nannie?        @relation(fields: [nannieId], references: [id])
  plaza        Plaza
  zona         String
  tipoServicio TipoServicio
  formato      Formato
  paqueteId    String? // si formato = PAQUETE, contra qué saldo se consume
  paquete      Paquete?       @relation(fields: [paqueteId], references: [id])
  numNinos     Int // validación por tipo: 1-3 general, 4-8 fiesta/ludoteca
  fecha        DateTime       @db.Date
  horaInicio   String // "HH:mm"
  horaFin      String
  // Reglamento PF §15-16: solo horas completas, mínimo 3.
  duracionHoras Int // se valida en el backend: entero, >= 3
  estado       EstadoServicio @default(OFERTADO)
  // Solo Ludoteca: +1 h de montaje/desmontaje en el PAGO a la nannie. Variable
  // (a veces no montan), por eso es un interruptor; encendido por defecto.
  ludotecaMontaje Boolean     @default(true)
  creadoEn     DateTime       @default(now())
  actualizadoEn DateTime      @updatedAt

  ofertas OfertaRespuesta[]
  finanza FinanzaServicio?

  @@index([nannieId, fecha])
  @@index([familiaId])
  @@index([estado])
  @@map("servicios")
}

// Registro de oferta→respuesta; alimenta la estadística de rechazo (M6)
// y puede disparar incidencias (M4).
model OfertaRespuesta {
  id            String          @id @default(cuid())
  servicioId    String
  servicio      Servicio        @relation(fields: [servicioId], references: [id])
  nannieId      String
  nannie        Nannie          @relation(fields: [nannieId], references: [id])
  respuesta     RespuestaOferta
  fechaRespuesta DateTime        @default(now())

  @@index([nannieId])
  @@map("ofertas_respuesta")
}

// Modelo "saldo": se cobra al inicio (M3), se consume servicio a servicio.
// El precio total viene de la tabla de cobro verificada (se cablea en M3).
model Paquete {
  id               String        @id @default(cuid())
  familiaId        String
  familia          Familia       @relation(fields: [familiaId], references: [id])
  horasTotales     Int // 10 / 20 / 30 / 40 / 50
  horasConsumidas  Int           @default(0)
  precioTotal      Decimal       @db.Decimal(10, 2)
  fechaContratacion DateTime      @default(now())
  estado           EstadoPaquete @default(ACTIVO)
  // La familia no dio fechas: las sesiones se asignan a mano conforme las pide
  // (no se programa de un jalón). Ver M2 §paquetes.
  asignacionManual Boolean       @default(false)

  servicios Servicio[]

  @@index([familiaId])
  @@map("paquetes")
}

// ------------------------------------------------------------
//  M3 · Finanzas
// ------------------------------------------------------------

// Una fila por servicio con su dinero. El cobro se conoce al crear (paquete
// prorrateado / individual del menú); el pago y el nivel se estampan al
// COMPLETAR (tabulador × nivel-tarifa del mes). El margen se DERIVA:
// cobro − pago − comisión − ajuste. El margen solo lo ve la Directora (RBAC).
model FinanzaServicio {
  id            String       @id @default(cuid())
  servicioId    String       @unique
  servicio      Servicio     @relation(fields: [servicioId], references: [id])
  cobroFamilia  Decimal      @db.Decimal(10, 2) // paquete (prorrateo) o individual (menú)
  // Tarifas por hora por banda (M3, tarifas combinadas día/noche). Se guardan
  // para poder recalcular el cobro al extender el servicio. Null en paquete/ludoteca.
  tarifaDia     Decimal?     @db.Decimal(10, 2)
  tarifaNoche   Decimal?     @db.Decimal(10, 2)
  pagoNannie    Decimal?     @db.Decimal(10, 2) // se fija al COMPLETAR
  nivelAplicado NivelTarifa? // nivel-tarifa con el que se pagó (auditable)
  comision      Decimal?     @db.Decimal(10, 2) // manual, opcional (en blanco por defecto)
  ajuste        Decimal?     @db.Decimal(10, 2) // manual (descuento/ajuste al COBRO de la familia)
  // Descuento al PAGO de la nannie por incidencia (M4). Reduce su pago → el
  // margen SUBE. Lo aplica la Directora desde la bandeja de incidencias.
  descuentoNannie Decimal?   @db.Decimal(10, 2)
  creadoEn      DateTime     @default(now())
  actualizadoEn DateTime     @updatedAt

  @@map("finanzas_servicio")
}

// Registro AUDITABLE del cierre de mes (§6.2): para cada nannie, qué nivel-tarifa
// se le fijó para el mes que ENTRA y con cuántas horas del mes previo se decidió.
model CierreMes {
  id             String      @id @default(cuid())
  nannieId       String
  nannie         Nannie      @relation(fields: [nannieId], references: [id])
  anio           Int // año del mes que ENTRA
  mes            Int // mes que ENTRA (1-12)
  horasMesPrevio Decimal     @db.Decimal(6, 2) // horas del mes que cerró
  nivelAsignado  NivelTarifa
  creadoEn       DateTime    @default(now())

  @@unique([nannieId, anio, mes])
  @@index([nannieId])
  @@map("cierres_mes")
}
